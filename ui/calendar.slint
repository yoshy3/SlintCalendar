            DayCell { day-num: root.get-day(27); day-clicked => { if (root.get-day(27) > 0) { root.selected-date = "Selected: " + root.get-day(27); root.day-selected(27); } } }
        }

        // Week 5
        HorizontalBox {
            spacing: 5px;
            alignment: center;
            visible: root.num-rows >= 5;
            DayCell { day-num: root.get-day(28); day-clicked => { if (root.get-day(28) > 0) { root.selected-date = "Selected: " + root.get-day(28); root.day-selected(28); } } }
            DayCell { day-num: root.get-day(29); day-clicked => { if (root.get-day(29) > 0) { root.selected-date = "Selected: " + root.get-day(29); root.day-selected(29); } } }
            DayCell { day-num: root.get-day(30); day-clicked => { if (root.get-day(30) > 0) { root.selected-date = "Selected: " + root.get-day(30); root.day-selected(30); } } }
            DayCell { day-num: root.get-day(31); day-clicked => { if (root.get-day(31) > 0) { root.selected-date = "Selected: " + root.get-day(31); root.day-selected(31); } } }
            DayCell { day-num: root.get-day(32); day-clicked => { if (root.get-day(32) > 0) { root.selected-date = "Selected: " + root.get-day(32); root.day-selected(32); } } }
            DayCell { day-num: root.get-day(33); day-clicked => { if (root.get-day(33) > 0) { root.selected-date = "Selected: " + root.get-day(33); root.day-selected(33); } } }
            DayCell { day-num: root.get-day(34); day-clicked => { if (root.get-day(34) > 0) { root.selected-date = "Selected: " + root.get-day(34); root.day-selected(34); } } }
        }

        // Week 6
        HorizontalBox {
            spacing: 5px;
            alignment: center;
            visible: root.num-rows >= 6;
            DayCell { day-num: root.get-day(35); day-clicked => { if (root.get-day(35) > 0) { root.selected-date = "Selected: " + root.get-day(35); root.day-selected(35); } } }
            DayCell { day-num: root.get-day(36); day-clicked => { if (root.get-day(36) > 0) { root.selected-date = "Selected: " + root.get-day(36); root.day-selected(36); } } }
            DayCell { day-num: root.get-day(37); day-clicked => { if (root.get-day(37) > 0) { root.selected-date = "Selected: " + root.get-day(37); root.day-selected(37); } } }
            DayCell { day-num: root.get-day(38); day-clicked => { if (root.get-day(38) > 0) { root.selected-date = "Selected: " + root.get-day(38); root.day-selected(38); } } }
            DayCell { day-num: root.get-day(39); day-clicked => { if (root.get-day(39) > 0) { root.selected-date = "Selected: " + root.get-day(39); root.day-selected(39); } } }
            DayCell { day-num: root.get-day(40); day-clicked => { if (root.get-day(40) > 0) { root.selected-date = "Selected: " + root.get-day(40); root.day-selected(40); } } }
            DayCell { day-num: root.get-day(41); day-clicked => { if (root.get-day(41) > 0) { root.selected-date = "Selected: " + root.get-day(41); root.day-selected(41); } } }
