            DayCell { day-num: root.get-day(4); day-clicked => { if (root.get-day(4) > 0) { root.selected-date = "Selected: " + root.get-day(4); root.day-selected(4); } } }
            DayCell { day-num: root.get-day(5); day-clicked => { if (root.get-day(5) > 0) { root.selected-date = "Selected: " + root.get-day(5); root.day-selected(5); } } }
            DayCell { day-num: root.get-day(6); day-clicked => { if (root.get-day(6) > 0) { root.selected-date = "Selected: " + root.get-day(6); root.day-selected(6); } } }
        }

