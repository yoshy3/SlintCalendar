        }

        // Week 3
        HorizontalBox {
            spacing: 5px;
            alignment: center;
            visible: root.num-rows >= 3;
            DayCell { day-num: root.get-day(14); day-clicked => { if (root.get-day(14) > 0) { root.selected-date = "Selected: " + root.get-day(14); root.day-selected(14); } } }
            DayCell { day-num: root.get-day(15); day-clicked => { if (root.get-day(15) > 0) { root.selected-date = "Selected: " + root.get-day(15); root.day-selected(15); } } }
            DayCell { day-num: root.get-day(16); day-clicked => { if (root.get-day(16) > 0) { root.selected-date = "Selected: " + root.get-day(16); root.day-selected(16); } } }
            DayCell { day-num: root.get-day(17); day-clicked => { if (root.get-day(17) > 0) { root.selected-date = "Selected: " + root.get-day(17); root.day-selected(17); } } }
            DayCell { day-num: root.get-day(18); day-clicked => { if (root.get-day(18) > 0) { root.selected-date = "Selected: " + root.get-day(18); root.day-selected(18); } } }
