            DayCell { day-num: root.get-day(7); day-clicked => { if (root.get-day(7) > 0) { root.selected-date = "Selected: " + root.get-day(7); root.day-selected(7); } } }
            DayCell { day-num: root.get-day(8); day-clicked => { if (root.get-day(8) > 0) { root.selected-date = "Selected: " + root.get-day(8); root.day-selected(8); } } }
            DayCell { day-num: root.get-day(9); day-clicked => { if (root.get-day(9) > 0) { root.selected-date = "Selected: " + root.get-day(9); root.day-selected(9); } } }
            DayCell { day-num: root.get-day(10); day-clicked => { if (root.get-day(10) > 0) { root.selected-date = "Selected: " + root.get-day(10); root.day-selected(10); } } }
            DayCell { day-num: root.get-day(11); day-clicked => { if (root.get-day(11) > 0) { root.selected-date = "Selected: " + root.get-day(11); root.day-selected(11); } } }
            DayCell { day-num: root.get-day(12); day-clicked => { if (root.get-day(12) > 0) { root.selected-date = "Selected: " + root.get-day(12); root.day-selected(12); } } }
