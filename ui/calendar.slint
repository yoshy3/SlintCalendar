import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

component DayCell inherits Rectangle {
    in property <int> day-num;
    callback day-clicked;
    width: 64px;
    height: 64px;
    background: transparent;
    Text {
        text: root.day-num > 0 ? ("" + root.day-num) : "";
        horizontal-alignment: center;
        vertical-alignment: center;
        color: #000000;
    }
    
    TouchArea {
        clicked => {
            root.day-clicked();
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> label;
    in property <length> btn-width: 48px;
    in property <length> btn-height: 48px;
    callback clicked;
    width: root.btn-width;
    height: root.btn-height;
    in property <brush> bgColor: #ffffff;
    background: root.bgColor;
    border-width: 1px;
    border-color: #e6e6e6;
    border-radius: 6px;

    Text {
        text: root.label;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: #222222;
        font-weight: 700;
        font-size: 14px;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "Slint Calendar";
    width: 600px;
    height: 700px;
    background: @linear-gradient(90deg, #f0f0f0, #ffffff);

    VerticalBox {
        spacing: 10px;
        padding: 10px;

        // Header with month/year and navigation
        HorizontalBox {
            alignment: center;
            spacing: 10px;

            IconButton { label: "←"; btn-width: 48px; btn-height: 48px; clicked => { root.prev-month(); } }

            Text {
                text: root.current-month;
                font-size: 24px;
                font-weight: 700;
                color: #222222;
            }

            IconButton { label: "→"; btn-width: 48px; btn-height: 48px; clicked => { root.next-month(); } }

            IconButton { label: "今日"; btn-width: 80px; btn-height: 48px; clicked => { root.go-today(); } }
        }

        // Day labels (Japanese)
        HorizontalBox {
            spacing: 5px;
            alignment: center;
            Text { text: "日"; font-weight: 700; horizontal-alignment: center; color: #444444; font-size: 14px; width: 64px; }
            Text { text: "月"; font-weight: 700; horizontal-alignment: center; color: #444444; font-size: 14px; width: 64px; }
            Text { text: "火"; font-weight: 700; horizontal-alignment: center; color: #444444; font-size: 14px; width: 64px; }
            Text { text: "水"; font-weight: 700; horizontal-alignment: center; color: #444444; font-size: 14px; width: 64px; }
            Text { text: "木"; font-weight: 700; horizontal-alignment: center; color: #444444; font-size: 14px; width: 64px; }
            Text { text: "金"; font-weight: 700; horizontal-alignment: center; color: #444444; font-size: 14px; width: 64px; }
            Text { text: "土"; font-weight: 700; horizontal-alignment: center; color: #444444; font-size: 14px; width: 64px; }
        }

        // Calendar grid - Week 1
        HorizontalBox {
            spacing: 5px;
            alignment: center;
            visible: root.num-rows >= 1;
            DayCell { day-num: root.get-day(0); day-clicked => { if (root.get-day(0) > 0) { root.selected-date = "Selected: " + root.get-day(0); root.day-selected(0); } } }
            DayCell { day-num: root.get-day(1); day-clicked => { if (root.get-day(1) > 0) { root.selected-date = "Selected: " + root.get-day(1); root.day-selected(1); } } }
            DayCell { day-num: root.get-day(2); day-clicked => { if (root.get-day(2) > 0) { root.selected-date = "Selected: " + root.get-day(2); root.day-selected(2); } } }
